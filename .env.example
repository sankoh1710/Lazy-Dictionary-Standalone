# Server-side only. Keep real values in Vercel settings or .env.local.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY

# Run locally with npx vercel dev to test saving words.
SPELLING_SUBMISSIONS_ENABLED=false

# Production stays off until you enable the feature yourself.
PUBLIC_SPELLING_SUBMISSIONS_ENABLED=false
PUBLIC_SPELLING_HOSTNAME=lazydictionary.com

# Required for the public five-per-minute limit. Use 32+ random characters.
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PUBLIC_RATE_LIMIT_PEPPER=REPLACE_WITH_PRIVATE_RANDOM_SECRET
