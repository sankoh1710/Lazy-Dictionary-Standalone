# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT.
# Never commit .env.local or real database credentials.
# Obtain the Project URL and a NEW secret key from Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Deliberately disabled unless you enable it for local testing.
# This flag enables LOCAL development writes only.
SPELLING_SUBMISSIONS_ENABLED=false

# Phase 6A — Supabase Auth sign-in for your local admin experiment.
# Publishable key is NOT a secret; it is used by server-side Auth calls here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# UUID of the specific admin user in Supabase Authentication > Users.
# DO NOT put the admin email or password in this file.
SUPABASE_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# PUBLIC LAUNCH — ALL DISABLED BY DEFAULT.
# Only set these on the real Production environment AFTER completing staging tests.
# Public writes still require ALL fields, correct hostname, Vercel production,
# Turnstile verification, and the public SQL rate-limit migration.
PUBLIC_SPELLING_SUBMISSIONS_ENABLED=false
PUBLIC_SPELLING_HOSTNAME=lazydictionary.com
TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_PRIVATE_SECRET_KEY
# Generate at least 32 random characters and keep it private.
PUBLIC_RATE_LIMIT_PEPPER=YOUR_RANDOM_32_OR_MORE_CHARACTER_SECRET
