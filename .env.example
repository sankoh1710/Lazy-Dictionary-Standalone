# Copy to .env.local for LOCAL development; never commit .env.local.
# These keys are used by Vercel Functions only, not browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# LOCAL TEST ONLY: enables localhost submissions with the 5/minute shared
# learning quota already installed in the original Supabase project.
SPELLING_SUBMISSIONS_ENABLED=false

# LOCAL ADMIN: only this Supabase Auth user's UUID can review submissions.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# LIVE SITE: configure ONLY in Vercel's Production Environment.
# Keep false until the public rate-limit SQL is installed and tested.
PUBLIC_SPELLING_SUBMISSIONS_ENABLED=false
PUBLIC_SPELLING_HOSTNAME=lazydictionary.com

# A private, random value of at least 32 characters. Used to create
# pseudonymous rate-limit keys without saving raw visitor IP addresses.
PUBLIC_RATE_LIMIT_PEPPER=REPLACE_WITH_PRIVATE_RANDOM_STRING_AT_LEAST_32_CHARS

# No Turnstile keys or separate staging database are required for this MVP.
# The public API never accepts writes on Vercel Preview deployments.
